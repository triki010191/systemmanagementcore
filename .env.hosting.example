# =============================================================================
# HFNMS — Template .env untuk hosting subdomain (PRODUCTION)
# PHP minimal 8.3 (cPanel Select PHP Version → 8.3)
# Salin isi file ini ke .env di server via File Manager cPanel
# Ganti semua nilai yang bertanda GANTI
# =============================================================================

APP_NAME=HFNMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hfnms.domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (dari cPanel → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_nama_database
DB_USERNAME=GANTI_user_database
DB_PASSWORD=GANTI_password_database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Shared hosting: nonaktifkan Reverb/WebSocket
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=GANTI_smtp.host.com
MAIL_PORT=587
MAIL_USERNAME=GANTI_email@domainanda.com
MAIL_PASSWORD=GANTI_password_smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@domainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Keamanan setup web (wajib diisi sebelum upload) ---
# Buat string acak panjang, contoh: openssl rand -hex 32
HOSTING_SETUP_KEY=GANTI_string_acak_panjang
CRON_SECRET_KEY=GANTI_string_acak_lain

# GIS — OSRM routing (opsional, pakai server sendiri di production)
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# Laravel AI SDK (opsional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
